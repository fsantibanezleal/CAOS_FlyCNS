{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["src"],
  "python.analysis.exclude": ["**/.venv*/**", "**/node_modules/**", "**/dist/**", "**/ts-out/**"],
  "files.watcherExclude": {
    "**/.venv*/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/ts-out/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {"**/.venv*": true, "**/node_modules": true, "**/dist": true, "**/ts-out": true}
}
