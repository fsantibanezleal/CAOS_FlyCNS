{
  "name": "@fasl-work/flycns",
  "version": "0.3.0",
  "description": "The flycns engine in the browser: load a compiled fly connectome and simulate the whole CNS (graded optic lobe plus spiking LIF) on WebGPU, with a worker fallback, held to the Python reference by parity tests.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"ts-out/test/**/*.test.js\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "author": "Felipe Santibanez-Leal <fsantibanez@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/fsantibanezleal/CAOS_FlyCNS.git" },
  "homepage": "https://github.com/fsantibanezleal/CAOS_FlyCNS",
  "bugs": { "url": "https://github.com/fsantibanezleal/CAOS_FlyCNS/issues" },
  "keywords": ["connectome", "drosophila", "malecns", "webgpu", "simulation", "spiking", "neuroscience"]
}
