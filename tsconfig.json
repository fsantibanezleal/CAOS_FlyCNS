{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["@webgpu/types"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "ts/src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["ts/src"]
}
